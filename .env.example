# Copy to `.env` and fill in. `.env` is gitignored — never commit real tokens.
#
# When KMS_AUTH_TOKEN or KMS_TENANT is missing, the server auto-runs in MOCK mode
# (returns realistic sample data) so you can demo it in Claude without credentials.

# --- Credentials (leave blank to stay in mock mode) ---
KMS_AUTH_TOKEN=
KMS_TENANT=

# --- Optional overrides ---
# Force mock on/off explicitly. "1"/"true" => mock; "0"/"false" => real (requires creds).
# If unset, mock turns on automatically whenever creds are missing.
# KMS_MOCK=1

# API base URL (the /api/discovery/getData path is appended by the client).
# KMS_BASE_URL=https://okf-be-prod-dot-ok-framework.el.r.appspot.com

# Path to your discovery schema. Defaults to the bundled template if unset.
# KMS_SCHEMA_PATH=./kms_schema.json

# Request timeout in seconds.
# KMS_TIMEOUT=30
