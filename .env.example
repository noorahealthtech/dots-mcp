# Copy to `.env` and fill in. `.env` is gitignored — never commit real tokens.
#
# When KMS_AUTH_TOKEN or KMS_TENANT is missing, the server auto-runs in MOCK mode
# (returns realistic sample data) so you can demo it in Claude without credentials.

# --- Credentials (leave blank to stay in mock mode) ---
KMS_AUTH_TOKEN=
KMS_TENANT=

# --- Optional overrides ---
# Force mock on/off explicitly. "1"/"true" => mock; "0"/"false" => real (requires creds).
# If unset, mock turns on automatically whenever creds are missing.
# KMS_MOCK=1

# API base URL (the /api/discovery/getData path is appended by the client).
# KMS_BASE_URL=https://okf-be-prod-dot-ok-framework.el.r.appspot.com

# Web-app base URL for human-facing citation deep links (source_url on every result):
# {KMS_WEB_URL}/published-page/{contentType}?id={_id}
# KMS_WEB_URL=https://knowledge.noorahealth.org

# Path to your discovery schema. Defaults to the bundled template if unset.
# KMS_SCHEMA_PATH=./kms_schema.json

# Request timeout in seconds.
# KMS_TIMEOUT=30

# ===========================================================================
# Remote connector (HTTP transport + OAuth). Leave all of this unset for the
# default local stdio mode (Claude Desktop) — these only apply to a hosted,
# publicly reachable deployment. See README "Remote deployment (VM)".
# ===========================================================================

# Transport: "stdio" (default) or "streamable-http" (the remote connector).
# KMS_TRANSPORT=streamable-http
# Bind address — keep on loopback; nginx is the only public listener.
# KMS_HOST=127.0.0.1
# KMS_PORT=8900
# Streaming/session behaviour (defaults shown; fine for a single VM).
# KMS_STATELESS_HTTP=1
# KMS_JSON_RESPONSE=1

# Public HTTPS base URL of this server (no trailing slash). Used as the OAuth
# issuer, the resource identifier, and the Google redirect base. REQUIRED for the
# OAuth bridge in production (defaults to http://KMS_HOST:KMS_PORT for local tests).
# KMS_PUBLIC_URL=https://dots.mcp.noorahealth.org

# --- OAuth bridge (Google-delegated login) ---
# Setting BOTH of these enables the bridge (only takes effect under the HTTP
# transport). They are your existing Google OAuth client's credentials. In the
# Google Cloud console, add this redirect URI to that client:
#   https://claude.ai/api/mcp/auth_callback     (Claude's callback)
#   {KMS_PUBLIC_URL}/auth/google/callback        (this server's callback)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Comma-separated email domains allowed to obtain a token (default below).
# KMS_ALLOWED_EMAIL_DOMAINS=noorahealth.org

# Restrict content queries to published documents (kp_published_status == "published").
# Defaults ON under the HTTP transport so the public connector doesn't expose the
# ~73% of docs that are unpublished drafts on the shared service token; OFF under stdio.
# Set to 0 to expose everything (drafts included) even remotely.
# KMS_PUBLISHED_ONLY=1

# Content creation is remote-OAuth-only and publishes immediately.
KMS_CREATE_ENABLED=0
# Required when creation is enabled; expose only registry-ready content types.
KMS_CREATE_CONTENT_TYPES=routineVisits
# Optional authoritative registry override; packaged registry fails closed by default.
# KMS_CREATE_SCHEMA_PATH=/run/secrets/kms_create_schema.json

# Access-token lifetime in seconds (refresh tokens rotate; state is in-memory, so
# a server restart simply forces users to re-authenticate).
# KMS_TOKEN_TTL=3600
